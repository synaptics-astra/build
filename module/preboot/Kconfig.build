	default 7 if VCPU_PMIC_I2CCH = "TW3"
	default 8 if VCPU_PMIC_I2CCH = "TW3A"
	default 9 if VCPU_PMIC_I2CCH = "TW3B"
	default 255

config VCORE_SMTMR_GPIO
	hex "GPIO used to identify VCORE SMTIMER PWM PIN"
	depends on PMIC_PWM_BACKEND_SMTIMER
	default 0xff
	help
		The GPIO number identifies the pin connected to the
		VCORE PWM signal and is used to determine the PWM
		channel configuration.

		Refer to the board schematic and PMIC datasheet to
		determine the PWM GPIO connection.



		- SoC GPIO:
			Enter the GPIO number directly.

		- SM GPIO:
			Set bit[31:30] to 2'b10 and place the SM GPIO number
			in bits[29:0].

		- GPIO-X:
			Set bit[31:30] to 2'b01 and place the GPIO_X number
			in bits[29:0].

		Examples:
		SoC GPIO 15:
			0xf

		SM GPIO 3:
			0x80000003

		GPIO_X10:
			0x4000000A

