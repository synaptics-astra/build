config VCPU_PWM_DUTY_AT_VOLT_MIN
	int "VCPU PWM Duty Cycle at Volt Min"
	depends on PMIC_IF_PWM
	default 802

config VCPU_PWM_DUTY_AT_VOLT_MAX
	int "VCPU PWM Duty Cycle at Volt Max"
	depends on PMIC_IF_PWM
	default 412

choice
	prompt "VCORE PMIC I2C pin group"
	default VCORE_PMIC_I2C_NONE_VAL
	depends on PMIC_IF_I2C || PMIC_IF_AUTO
	help
		Select the I2C pin group connected to the VCORE PMIC.

		This setting identifies the SCL/SDA pins used to access
		the PMIC and determines the corresponding I2C controller
		and pinmux configuration.

		Supported values: TW0, TW1, TW1A, TW1B, TW2, TW2A, TW2B, TW3, TW3A, TW3B.
		The value should be "NONE" if the VCORE rail is not connected to the PMIC.

		Refer to the board schematic and PMIC datasheet for the
		corresponding PMIC I2C pin group.

config VCORE_PMIC_I2C_NONE_VAL
	bool "NONE"

config VCORE_PMIC_I2C_TW0_VAL
	bool "TW0"

config VCORE_PMIC_I2C_TW1_VAL
	bool "TW1"

config VCORE_PMIC_I2C_TW1A_VAL
	bool "TW1A"

config VCORE_PMIC_I2C_TW1B_VAL
	bool "TW1B"

config VCORE_PMIC_I2C_TW2_VAL
	bool "TW2"

config VCORE_PMIC_I2C_TW2A_VAL
	bool "TW2A"

config VCORE_PMIC_I2C_TW2B_VAL
	bool "TW2B"

config VCORE_PMIC_I2C_TW3_VAL
	bool "TW3"

config VCORE_PMIC_I2C_TW3A_VAL
	bool "TW3A"

config VCORE_PMIC_I2C_TW3B_VAL
	bool "TW3B"
endchoice

config VCORE_PMIC_I2CCH
	string
	default "NONE" if VCORE_PMIC_I2C_NONE_VAL
	default "TW0"  if VCORE_PMIC_I2C_TW0_VAL
	default "TW1"  if VCORE_PMIC_I2C_TW1_VAL
	default "TW1A" if VCORE_PMIC_I2C_TW1A_VAL
	default "TW1B" if VCORE_PMIC_I2C_TW1B_VAL
	default "TW2"  if VCORE_PMIC_I2C_TW2_VAL
	default "TW2A" if VCORE_PMIC_I2C_TW2A_VAL
	default "TW2B" if VCORE_PMIC_I2C_TW2B_VAL
	default "TW3"  if VCORE_PMIC_I2C_TW3_VAL
	default "TW3A" if VCORE_PMIC_I2C_TW3A_VAL
	default "TW3B" if VCORE_PMIC_I2C_TW3B_VAL

config VCORE_PMIC_I2CCH_NUM
	int
	depends on PMIC_IF_I2C || PMIC_IF_AUTO
	default 0 if VCORE_PMIC_I2CCH = "TW0"
	default 1 if VCORE_PMIC_I2CCH = "TW1"
	default 2 if VCORE_PMIC_I2CCH = "TW1A"
	default 3 if VCORE_PMIC_I2CCH = "TW1B"
	default 4 if VCORE_PMIC_I2CCH = "TW2"
	default 5 if VCORE_PMIC_I2CCH = "TW2A"
	default 6 if VCORE_PMIC_I2CCH = "TW2B"
	default 7 if VCORE_PMIC_I2CCH = "TW3"
	default 8 if VCORE_PMIC_I2CCH = "TW3A"
	default 9 if VCORE_PMIC_I2CCH = "TW3B"
	default 255

choice
	prompt "VCPU PMIC I2C pin group"
	default VCPU_PMIC_I2C_NONE_VAL
