#
# For a description of the syntax of this configuration file,
# see Documentation/kbuild/kconfig-language.txt.
#

menu "Preboot Configuration"
depends on PREBOOT

config PREBOOT_MARKET_ID
	int "Market ID"
	default 7

config PREBOOT_REL_PATH
	string "Preboot release path"
	default "preboot"
	help
		Used as ${CONFIG_SYNA_SDK_OUT_TARGET_PATH}/${CONFIG_PREBOOT_REL_PATH}

config PREBOOT_DDR_TYPE
	string "memory type"
	default "ddr4"
	help
		Current valid value are ddr4, ddr3

config PREBOOT_MEMORY_SPEED
	int "memory speed"
	default 2400

config PREBOOT_MEMORY_SIZE
	string "memory size"
	default "2GB"

config PREBOOT_MEMORY_VARIANT
	string "memory variant"
	default "default/default"

config PREBOOT_MEMORY_MULTIPLE
	bool "multiple version of memory param table"
	default n

config PREBOOT_DDR_PHY_FW
	bool "ddr phy fw"
	default n

config PREBOOT_TEE_ENABLE
	bool "enable TEE in bootflow"
	default y

config PREBOOT_PROFILE
	string "profile for preboot"
	default "normal"
	help
		normal or nocs or nocs/type_i or nocs_test

config PREBOOT_SECURITY_IMAGE_PATH
	string
	default "boot/security/images"
	help
		Used as ${CONFIG_SYNA_SDK_PATH}/${CONFIG_PREBOOT_SECURITY_IMAGE_PATH}

config PREBOOT_ANDROID_BOOTCTRL
	bool "use android bootctrl format"
    default n

config PREBOOT_SKIP_FW
	bool "Skip firmware loading"
    default n

config PREBOOT_FORCE_SPI
	bool "Skip SD card checking when booting from SPI"
    default n

choice
	prompt "PMIC Control Interface"
	default PMIC_IF_LEGACY

config PMIC_IF_I2C
	bool "I2C"

config PMIC_IF_PWM
	bool "PWM"

config PMIC_IF_AUTO
	bool "Auto Detect"

config PMIC_IF_LEGACY
	bool "Legacy"

endchoice

if PMIC_IF_PWM

choice
	prompt "PWM Backend"

config PMIC_PWM_BACKEND_PWM
	bool "PWM Controller"

config PMIC_PWM_BACKEND_SMTIMER
	bool "SM Timer Controller"

endchoice

endif

choice
	prompt "VCORE PMIC Model"
	default VCORE_PMIC_MODEL_NONE
	depends on PMIC_IF_I2C
	help
		Specify the single PMIC model to be used for VCORE.
		Select the model that matches the hardware configuration of your board.

config VCORE_PMIC_MODEL_NONE
	bool "None"

config VCORE_PMIC_MODEL_M88PG86X
	bool "m88pg86x"

config VCORE_PMIC_MODEL_SY8824B
	bool "sy8824b"

config VCORE_PMIC_MODEL_NCP6335D
	bool "ncp6335d"

config VCORE_PMIC_MODEL_MP886X
	bool "mp886x"

config VCORE_PMIC_MODEL_SY8827N
	bool "sy8827n"

config VCORE_PMIC_MODEL_HL7593WL06
	bool "hl7593wl06"

config VCORE_PMIC_MODEL_TPS62868
	bool "tps62868"

config VCORE_PMIC_MODEL_RT5739
	bool "rt5739"

config VCORE_PMIC_MODEL_PWM_PMIC
	bool "pwm_pmic"

config VCORE_PMIC_MODEL_TPS6287X
	bool "tps6287x"

config VCORE_PMIC_MODEL_RT5733
	bool "rt5733"

config VCORE_PMIC_MODEL_SMTIMER
	bool "smtimer"

endchoice

config VCORE_PMIC_MODEL
	string
	default "m88pg86x"  if VCORE_PMIC_MODEL_M88PG86X
	default "sy8824b"   if VCORE_PMIC_MODEL_SY8824B
	default "ncp6335d"  if VCORE_PMIC_MODEL_NCP6335D
	default "mp886x"    if VCORE_PMIC_MODEL_MP886X
	default "sy8827n"   if VCORE_PMIC_MODEL_SY8827N
	default "hl7593wl06" if VCORE_PMIC_MODEL_HL7593WL06
	default "tps62868"  if VCORE_PMIC_MODEL_TPS62868
	default "rt5739"    if VCORE_PMIC_MODEL_RT5739
	default "pwm_pmic"  if VCORE_PMIC_MODEL_PWM_PMIC
	default "tps6287x"  if VCORE_PMIC_MODEL_TPS6287X
	default "rt5733"    if VCORE_PMIC_MODEL_RT5733
	default "smtimer"   if VCORE_PMIC_MODEL_SMTIMER
	default ""          if VCORE_PMIC_MODEL_NONE

config VCORE_PMIC_GPIOH
	hex "VCORE PMIC ID bit1 GPIO number"
	depends on PMIC_IF_AUTO
	default 0xff
	help
		GPIO number used for PMIC auto-detection.
		The value sampled from this GPIO is used as PMIC ID bit1.
		Together with PMIC ID bit0, it forms a 2-bit [bit1:bit0] PMIC
		identification code.
		Refer to the board schematic and PMIC datasheet for the
		corresponding GPIO numbers.

		- SoC GPIO:
			Enter the GPIO number directly.

		- SM GPIO:
			Set bit[31:30] to 2'b10 and place the SM GPIO number
			in bits[29:0].

		- GPIO-X:
			Set bit[31:30] to 2'b01 and place the GPIO_X number
			in bits[29:0].

		Examples:
		SoC GPIO 15:
			0xf

		SM GPIO 3:
			0x80000003

		GPIO_X10:
			0x4000000A

config VCORE_PMIC_GPIOL
	hex "VCORE PMIC ID bit0 GPIO number"
	depends on PMIC_IF_AUTO
	default 0xff
	help
		GPIO number used for PMIC auto-detection.
		The value sampled from this GPIO is used as PMIC ID bit0.
		Together with PMIC ID bit1, it forms a 2-bit [bit1:bit0] PMIC
		identification code.
		Refer to the board schematic and PMIC datasheet for the
		corresponding GPIO numbers.

		- SoC GPIO:
			Enter the GPIO number directly.

		- SM GPIO:
			Set bit[31:30] to 2'b10 and place the SM GPIO number
			in bits[29:0].

		- GPIO-X:
			Set bit[31:30] to 2'b01 and place the GPIO_X number
			in bits[29:0].

		Examples:
		SoC GPIO 15:
			0xf

		SM GPIO 3:
			0x80000003

		GPIO_X10:
			0x4000000A

config VCORE_PMIC_MODEL_0
	string "VCORE PMIC model for ID 2'b00"
	depends on PMIC_IF_AUTO
	default "none"
	help
		PMIC model associated with PMIC ID 2'b00.

		During boot, the values sampled from GPIOH and GPIOL
		form a 2-bit PMIC identification code:

		GPIOH=0, GPIOL=0  -> PMIC ID = 2'b00

		When this ID is detected, the PMIC model specified
		here will be used for VCORE control.

		Supported PMIC models are listed in:
		build/module/preboot/pmic_models

config VCORE_PMIC_MODEL_1
	string "VCORE PMIC model for ID 2'b01"
	depends on PMIC_IF_AUTO
	default "none"
	help
		PMIC model associated with PMIC ID 2'b01.

		During boot, the values sampled from GPIOH and GPIOL
		form a 2-bit PMIC identification code:

		GPIOH=0, GPIOL=1  -> PMIC ID = 2'b01

		When this ID is detected, the PMIC model specified
		here will be used for VCORE control.

		Supported PMIC models are listed in:
		build/module/preboot/pmic_models

config VCORE_PMIC_MODEL_2
	string "VCORE PMIC model for ID 2'b10"
	depends on PMIC_IF_AUTO
	default "none"
	help
		PMIC model associated with PMIC ID 2'b10.

		During boot, the values sampled from GPIOH and GPIOL
		form a 2-bit PMIC identification code:

		GPIOH=1, GPIOL=0  -> PMIC ID = 2'b10

		When this ID is detected, the PMIC model specified
		here will be used for VCORE control.

		Supported PMIC models are listed in:
		build/module/preboot/pmic_models

config VCORE_PMIC_MODEL_3
	string "VCORE PMIC model for ID 2'b11"
	depends on PMIC_IF_AUTO
	default "none"
	help
		PMIC model associated with PMIC ID 2'b11.

		During boot, the values sampled from GPIOH and GPIOL
		form a 2-bit PMIC identification code:

		GPIOH=1, GPIOL=1  -> PMIC ID = 2'b11

		When this ID is detected, the PMIC model specified
		here will be used for VCORE control.

		Supported PMIC models are listed in:
		build/module/preboot/pmic_models

choice
	prompt "VCPU PMIC Model"
	default VCPU_PMIC_MODEL_NONE
	depends on PMIC_IF_I2C
	help
		Specify the single PMIC model to be used for VCPU.
		Select the model that matches the hardware configuration of your board.

config VCPU_PMIC_MODEL_NONE
	bool "None"

config VCPU_PMIC_MODEL_M88PG86X
	bool "m88pg86x"

config VCPU_PMIC_MODEL_SY8824B
	bool "sy8824b"

config VCPU_PMIC_MODEL_NCP6335D
	bool "ncp6335d"

config VCPU_PMIC_MODEL_MP886X
	bool "mp886x"

config VCPU_PMIC_MODEL_SY8827N
	bool "sy8827n"

config VCPU_PMIC_MODEL_HL7593WL06
	bool "hl7593wl06"

config VCPU_PMIC_MODEL_TPS62868
	bool "tps62868"

config VCPU_PMIC_MODEL_RT5739
	bool "rt5739"

config VCPU_PMIC_MODEL_PWM_PMIC
	bool "pwm_pmic"

config VCPU_PMIC_MODEL_TPS6287X
	bool "tps6287x"

config VCPU_PMIC_MODEL_RT5733
	bool "rt5733"

config VCPU_PMIC_MODEL_SMTIMER
	bool "smtimer"

endchoice

config VCPU_PMIC_MODEL
	string
	default "m88pg86x"  if VCPU_PMIC_MODEL_M88PG86X
	default "sy8824b"   if VCPU_PMIC_MODEL_SY8824B
	default "ncp6335d"  if VCPU_PMIC_MODEL_NCP6335D
	default "mp886x"    if VCPU_PMIC_MODEL_MP886X
	default "sy8827n"   if VCPU_PMIC_MODEL_SY8827N
	default "hl7593wl06" if VCPU_PMIC_MODEL_HL7593WL06
	default "tps62868"  if VCPU_PMIC_MODEL_TPS62868
	default "rt5739"    if VCPU_PMIC_MODEL_RT5739
	default "pwm_pmic"  if VCPU_PMIC_MODEL_PWM_PMIC
	default "tps6287x"  if VCPU_PMIC_MODEL_TPS6287X
	default "rt5733"    if VCPU_PMIC_MODEL_RT5733
	default "smtimer"   if VCPU_PMIC_MODEL_SMTIMER
	default ""          if VCPU_PMIC_MODEL_NONE

config VCPU_PMIC_GPIOH
	hex "VCPU PMIC ID bit1 GPIO number"
	depends on PMIC_IF_AUTO
	default 0xff
	help
		GPIO number used for PMIC auto-detection.
		The value sampled from this GPIO is used as PMIC ID bit1.
		Together with PMIC ID bit0, it forms a 2-bit [bit1:bit0] PMIC
		identification code.
		Refer to the board schematic and PMIC datasheet for the
		corresponding GPIO numbers.

		- SoC GPIO:
			Enter the GPIO number directly.

		- SM GPIO:
			Set bit[31:30] to 2'b10 and place the SM GPIO number
			in bits[29:0].

		- GPIO-X:
			Set bit[31:30] to 2'b01 and place the GPIO_X number
			in bits[29:0].

		Examples:
		SoC GPIO 15:
			0xf

		SM GPIO 3:
			0x80000003

		GPIO_X10:
			0x4000000A

