config VCPU_PMIC_I2C_TW3B_VAL
	bool "TW3B"
endchoice

config VCPU_PMIC_I2CCH
	string
	default "NONE" if VCPU_PMIC_I2C_NONE_VAL
	default "TW0"  if VCPU_PMIC_I2C_TW0_VAL
	default "TW1"  if VCPU_PMIC_I2C_TW1_VAL
