#
# For a description of the syntax of this configuration file,
# see Documentation/kbuild/kconfig-language.txt.
#

menu "Preboot Configuration"
depends on PREBOOT

config PREBOOT_MARKET_ID
	int "Market ID"
	default 7

config PREBOOT_REL_PATH
	string "Preboot release path"
	default "preboot"
	help
		Used as ${CONFIG_SYNA_SDK_OUT_TARGET_PATH}/${CONFIG_PREBOOT_REL_PATH}

config PREBOOT_DDR_TYPE
	string "memory type"
	default "ddr4"
	help
		Current valid value are ddr4, ddr3

config PREBOOT_MEMORY_SPEED
	int "memory speed"
	default 2400

config PREBOOT_MEMORY_SIZE
	string "memory size"
	default "2GB"

config PREBOOT_MEMORY_VARIANT
	string "memory variant"
	default "default/default"

config PREBOOT_MEMORY_MULTIPLE
	bool "multiple version of memory param table"
	default n

config PREBOOT_DDR_PHY_FW
	bool "ddr phy fw"
	default n

config PREBOOT_TEE_ENABLE
	bool "enable TEE in bootflow"
	default y

config PREBOOT_PROFILE
	string "profile for preboot"
	default "normal"
	help
		normal or nocs or nocs/type_i or nocs_test

config PREBOOT_SECURITY_IMAGE_PATH
	string
	default "boot/security/images"
	help
		Used as ${CONFIG_SYNA_SDK_PATH}/${CONFIG_PREBOOT_SECURITY_IMAGE_PATH}

config PREBOOT_ANDROID_BOOTCTRL
	bool "use android bootctrl format"
    default n

config PREBOOT_SKIP_FW
	bool "Skip firmware loading"
    default n

config PREBOOT_FORCE_SPI
	bool "Skip SD card checking when booting from SPI"
    default n

choice
	prompt "PMIC Control Mode"
	optional
	help
		Choose between I2C PMIC control or PWM voltage regulation.
		I2C mode uses traditional PMIC drivers via I2C bus.
		PWM mode uses direct PWM signals for voltage control.
		Leave unselected to disable PMIC configuration.

config PMIC_MODE_I2C
	bool "I2C PMIC Control"
	help
		Use traditional I2C PMIC drivers for voltage regulation.
		Configure VCORE and VCPU PMIC models below.

config PMIC_MODE_PWM
	bool "PWM Voltage Control"
	help
		Use PWM signals for direct voltage regulation.
		Configure PWM channels for VCORE and VCPU below.

endchoice

config VCORE_PMIC_MODEL
	string "VCORE PMIC Model"
	depends on PMIC_MODE_I2C
	help
		Specify the PMIC model to be used for VCORE by the miniloader.
		Supported models: m88pg86x, sy8824b, ncp6335d, mp886x, sy8827n,
		hl7593wl06, tps62868, rt573x, fp6359, tps6287x...
		This configuration will be used to generate a binary configuration
		file that miniloader reads during boot to select the appropriate
		PMIC driver for VCORE. Supported PMIC_MODELS list refers to ./gen_pmic_config.sh

config VCPU_PMIC_MODEL
	string "VCPU PMIC Model"
	depends on PMIC_MODE_I2C
	help
		Specify the PMIC model to be used for VCPU by the miniloader.
		Supported models: m88pg86x, sy8824b, ncp6335d, mp886x, sy8827n,
		hl7593wl06, tps62868, rt573x, fp6359, tps6287x...
		This configuration will be used to generate a binary configuration
		file that miniloader reads during boot to select the appropriate
		PMIC driver for VCPU. Supported PMIC_MODELS list refers to ./gen_pmic_config.sh

config VCORE_PMIC_PWMCH
	string "VCORE PMIC PWM Channel"
	depends on PMIC_MODE_PWM
	help
		Specify the PWM channel to be used for VCORE by the miniloader.
		Supported channels: 0-255, or empty string for not configured.
		Empty string will be converted to 0xFF (not configured).
		This configuration will be used to generate a binary configuration
		file that miniloader reads during boot to select the appropriate
		PWM channel for VCORE voltage regulation.

config VCPU_PMIC_PWMCH
	string "VCPU PMIC PWM Channel"
	depends on PMIC_MODE_PWM
	help
		Specify the PWM channel to be used for VCPU by the miniloader.
		Supported channels: 0-255, or empty string for not configured.
		Empty string will be converted to 0xFF (not configured).
		This configuration will be used to generate a binary configuration
		file that miniloader reads during boot to select the appropriate
		PWM channel for VCPU voltage regulation.
endmenu
