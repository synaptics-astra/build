config VCORE_PWM_GPIO
	hex "GPIO used to identify VCORE TYPICAL PWM PIN"
	depends on PMIC_PWM_BACKEND_PWM
	default 0xff
	help
		The GPIO number identifies the pin connected to the
		VCORE PWM signal and is used to determine the PWM
		channel configuration.

		Refer to the board schematic and PMIC datasheet to
		determine the PWM GPIO connection.

		- SoC GPIO:
			Enter the GPIO number directly.

		- SM GPIO:
			Set bit[31:30] to 2'b10 and place the SM GPIO number
			in bits[29:0].

		- GPIO-X:
			Set bit[31:30] to 2'b01 and place the GPIO_X number
			in bits[29:0].

		Examples:
		SoC GPIO 15:
			0xf

		SM GPIO 3:
			0x80000003

		GPIO_X10:
			0x4000000A

config VCPU_PWM_GPIO
	hex "GPIO used to identify VCPU TYPICAL PWM PIN"
	depends on PMIC_PWM_BACKEND_PWM
	default 0xff
	help
		The GPIO number identifies the pin connected to the
		VCPU PWM signal and is used to determine the PWM
		channel configuration.

		Refer to the board schematic and PMIC datasheet to
		determine the PWM GPIO connection.


		- SoC GPIO:
			Enter the GPIO number directly.

		- SM GPIO:
			Set bit[31:30] to 2'b10 and place the SM GPIO number
			in bits[29:0].

		- GPIO-X:
			Set bit[31:30] to 2'b01 and place the GPIO_X number
			in bits[29:0].

		Examples:
		SoC GPIO 15:
			0xf

		SM GPIO 3:
			0x80000003

		GPIO_X10:
			0x4000000A

config VCORE_PWM_FREQ_HZ
	int "VCORE PWM Frequency (Hz)"
	depends on PMIC_IF_PWM
	default 100000

config VCORE_PWM_POLARITY
	int "VCORE PWM Polarity"
	depends on PMIC_IF_PWM
	default 0

config VCORE_PWM_VOLT_MIN_UV
	int "VCORE PWM Voltage Min (uV)"
	depends on PMIC_IF_PWM
	default 737500

config VCORE_PWM_VOLT_MAX_UV
	int "VCORE PWM Voltage Max (uV)"
	depends on PMIC_IF_PWM
	default 900000

config VCORE_PWM_DUTY_AT_VOLT_MIN
	int "VCORE PWM Duty Cycle at Volt Min"
	depends on PMIC_IF_PWM
	default 802

config VCORE_PWM_DUTY_AT_VOLT_MAX
	int "VCORE PWM Duty Cycle at Volt Max"
	depends on PMIC_IF_PWM
	default 412

config VCPU_PWM_FREQ_HZ
	int "VCPU PWM Frequency (Hz)"
	depends on PMIC_IF_PWM
	default 100000

config VCPU_PWM_POLARITY
	int "VCPU PWM Polarity"
	depends on PMIC_IF_PWM
