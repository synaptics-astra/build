	default "TW3B" if VCPU_PMIC_I2C_TW3B_VAL

config VCPU_PMIC_I2CCH_NUM
	int
	depends on PMIC_IF_I2C || PMIC_IF_AUTO
	default 0 if VCPU_PMIC_I2CCH = "TW0"
	default 1 if VCPU_PMIC_I2CCH = "TW1"
	default 2 if VCPU_PMIC_I2CCH = "TW1A"
	default 3 if VCPU_PMIC_I2CCH = "TW1B"
	default 4 if VCPU_PMIC_I2CCH = "TW2"
	default 5 if VCPU_PMIC_I2CCH = "TW2A"
