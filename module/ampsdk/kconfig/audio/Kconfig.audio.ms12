#
# For a description of the syntax of this configuration file,
# see Documentation/kbuild/kconfig-language.txt.
#

menu "MS12 Solution"

config AMP_IP_AUDIO_MS12_SUPPORTED
	bool "MS12"
	default n
	select AMP_IP_AUDIO_MS12_USE_HIFI if AMP_AUDIO_USE_DSP_HIFI
	select AMP_IP_AUDIO_MS12_USE_ARM if (AMP_AUDIO_USE_ARM_ONLY || AMP_AUDIO_RELEASE)

config AMP_IP_AUDIO_MS12_USE_HIFI
	bool
config AMP_IP_AUDIO_MS12_USE_ARM
	bool

if AMP_IP_AUDIO_MS12_USE_HIFI

menuconfig AMP_IP_AUDIO_MS12_HIFI_V2_6
	bool "MS12 v2.6"
	default y

if AMP_IP_AUDIO_MS12_HIFI_V2_6
config AMP_IP_AUDIO_MS12_HIFI_V2_6_X
	bool "MS12 v2.6 config X"
	default y
config AMP_IP_AUDIO_MS12_HIFI_V2_6_Y
	bool "MS12 v2.6 config Y"
	default n
config AMP_IP_AUDIO_MS12_HIFI_V2_6_Z
	bool "MS12 v2.6 config Z"
	default n
endif

endif

if AMP_IP_AUDIO_MS12_USE_ARM

choice
	prompt "MS12 Version"
	default AMP_IP_AUDIO_MS12_ARM_V2_4

config AMP_IP_AUDIO_MS12_ARM_V2_4
	bool "MS12v2.4"

config AMP_IP_AUDIO_MS12_ARM_V2_8_1
	bool "MS12v2.8.1"
endchoice

if AMP_IP_AUDIO_MS12_ARM_V2_4
choice
	prompt "Configuration"
	default AMP_IP_AUDIO_MS12_ARM_V2_4_Z

config AMP_IP_AUDIO_MS12_ARM_V2_4_Y_LITE
	bool "MS12 v2.4 config Y LITE"

config AMP_IP_AUDIO_MS12_ARM_V2_4_Y
	bool "MS12 v2.4 config Y"

config AMP_IP_AUDIO_MS12_ARM_V2_4_Z
	bool "MS12 v2.4 config Z"
endchoice
endif

if AMP_IP_AUDIO_MS12_ARM_V2_8_1
choice AMP_IP_AUDIO_MS12_ARM_V2_8_1_Y
	prompt "Configuration"
	default AMP_IP_AUDIO_MS12_ARM_V2_8_1_Y

config AMP_IP_AUDIO_MS12_ARM_V2_8_1_Y
	bool "MS12 v2.8.1 config Y"
endchoice
endif

config MS12_VERSION
	string
	default "V2_4" if AMP_IP_AUDIO_MS12_ARM_V2_4
	default "V2_8_1" if AMP_IP_AUDIO_MS12_ARM_V2_8_1

endif

endmenu

