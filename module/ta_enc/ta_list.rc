    if [ "is${CONFIG_AMP_DOLBY_VISION_V2_4}" = "isy" ]; then
        ta_path_list="${ta_path_list} libdvs.ta_v2_4"
        ta_list="${ta_list} libdvs.ta"
    fi
    if [ "is${CONFIG_AMP_DOLBY_VISION_V2_6}" = "isy" ]; then
        ta_path_list="${ta_path_list} libdvs.ta_v2_6"
        ta_list="${ta_list} libdvs.ta"
