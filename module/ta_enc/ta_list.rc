fi

if [ "is${CONFIG_AMP_AUDIO_WMA_USE_ARM}" = "isy" ]; then
    ta_path_list="${ta_path_list} libwma.ta"
    ta_list="${ta_list} libwma.ta"
fi

if [ "is${CONFIG_ENABLE_VPP_TZ}" = "isy" ]; then
    ta_path_list="${ta_path_list} liboutctrl.ta"
    ta_list="${ta_list} liboutctrl.ta"
    if [ "is${CONFIG_SYNA_SDK_REL_PATH}" = "is" ]; then
        if [ "is${CONFIG_AMP_DOLBY_VISION}" = "isy" ]; then
            if [ "is${CONFIG_AMP_HDR10_PLUS}" = "isy" ]; then
                if [ "is${CONFIG_AMP_DOLBY_VISION_V2_4}" = "isy" ]; then
                    if [ "is${CONFIG_AMP_HDMI_HDCP}" = "isy" ]; then
                        ta_path_list="${ta_path_list} libvpp_hdcp_dv_v2_4_hdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    else
                        ta_path_list="${ta_path_list} libvpp_nohdcp_dv_v2_4_hdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    fi
                fi
                if [ "is${CONFIG_AMP_DOLBY_VISION_V2_6}" = "isy" ]; then
                    if [ "is${CONFIG_AMP_HDMI_HDCP}" = "isy" ]; then
                        ta_path_list="${ta_path_list} libvpp_hdcp_dv_v2_6_hdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    else
                        ta_path_list="${ta_path_list} libvpp_nohdcp_dv_v2_6_hdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    fi
                fi
            else
                if [ "is${CONFIG_AMP_DOLBY_VISION_V2_4}" = "isy" ]; then
                    if [ "is${CONFIG_AMP_HDMI_HDCP}" = "isy" ]; then
                        ta_path_list="${ta_path_list} libvpp_hdcp_dv_v2_4_nohdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    else
                        ta_path_list="${ta_path_list} libvpp_nohdcp_dv_v2_4_nohdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    fi
                fi
                if [ "is${CONFIG_AMP_DOLBY_VISION_V2_6}" = "isy" ]; then
                    if [ "is${CONFIG_AMP_HDMI_HDCP}" = "isy" ]; then
                        ta_path_list="${ta_path_list} libvpp_hdcp_dv_v2_6_nohdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    else
                        ta_path_list="${ta_path_list} libvpp_nohdcp_dv_v2_6_nohdr10Plus"
                        ta_list="${ta_list} libvpp.ta"
                    fi
                fi
            fi
        else
            if [ "is${CONFIG_AMP_HDR10_PLUS}" = "isy" ]; then
                if [ "is${CONFIG_AMP_HDMI_HDCP}" = "isy" ]; then
                    ta_path_list="${ta_path_list} libvpp_hdcp_nodv_hdr10Plus"
                    ta_list="${ta_list} libvpp.ta"
                else
                    ta_path_list="${ta_path_list} libvpp_nohdcp_nodv_hdr10Plus"
                    ta_list="${ta_list} libvpp.ta"
                fi
            else
                if [ "is${CONFIG_AMP_HDMI_HDCP}" = "isy" ]; then
                    ta_path_list="${ta_path_list} libvpp_hdcp_nodv_nohdr10Plus"
                    ta_list="${ta_list} libvpp.ta"
                else
                    ta_path_list="${ta_path_list} libvpp_nohdcp_nodv_nohdr10Plus"
                    ta_list="${ta_list} libvpp.ta"
                fi
            fi
        fi
    else
        ta_path_list="${ta_path_list} libvpp_hdcp_nodv_nohdr10Plus libvpp_nohdcp_nodv_nohdr10Plus libvpp_hdcp_dv_v2_4_nohdr10Plus"
        ta_list="${ta_list} libvpp.ta libvpp.ta libvpp.ta"
        ta_path_list="${ta_path_list} libvpp_nohdcp_dv_v2_4_nohdr10Plus libvpp_hdcp_dv_v2_4_hdr10Plus libvpp_nohdcp_dv_v2_4_hdr10Plus"
        ta_list="${ta_list} libvpp.ta libvpp.ta libvpp.ta"
        ta_path_list="${ta_path_list} libvpp_hdcp_dv_v2_6_nohdr10Plus libvpp_nohdcp_dv_v2_6_nohdr10Plus libvpp_hdcp_dv_v2_6_hdr10Plus"
        ta_list="${ta_list} libvpp.ta libvpp.ta libvpp.ta"
        ta_path_list="${ta_path_list} libvpp_nohdcp_dv_v2_6_hdr10Plus libvpp_hdcp_nodv_hdr10Plus libvpp_nohdcp_nodv_hdr10Plus"
        ta_list="${ta_list} libvpp.ta libvpp.ta libvpp.ta"
    fi
fi


